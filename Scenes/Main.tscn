[sub_resource type="GDScript" id=4]
script/source = "extends Area2D

func _ready():
	connect(\"body_entered\", self, \"_on_body_entered\")

func _on_body_entered(body):
	if body.name == \"Player\":
		var pegou = InventarioManager.adicionar_item(\"Chave de fenda\")
		
		
		if pegou:
			queue_free() # remove o item do mapa
"

[sub_resource type="GDScript" id=5]
script/source = "extends Area2D

func _ready():
	connect(\"body_entered\", self, \"_on_body_entered\")

func _on_body_entered(body):
	if body.name == \"Player\":
		var pegou = InventarioManager.adicionar_item(\"Chave Universal\")
		
		
		if pegou:
			queue_free() # remove o item do mapa
"

